# Configuration reference: http://docs.postiz.com/configuration/reference

# === Required Settings
#
# Postgres (Prisma): DATABASE_URL is the primary connection; DIRECT_DATABASE_URL is used for
# migrations / introspection (no PgBouncer). For local Docker, set both to the same URI.
#
# Supabase: copy URIs from Dashboard → Database (region-specific pooler host). Do not commit secrets.
# - Runtime/pooled: "Transaction pooler" — host *.pooler.supabase.com, user postgres.<project_ref>,
#   port 6543, query params e.g. ?pgbouncer=true&sslmode=require (add connect_timeout= if needed).
# - Migrations/direct: "Direct connection" or session pooler on :5432 — Prisma CLI cannot use
#   transaction mode on :6543. Avoid assuming db.<ref>.supabase.co:6543; pooler host differs.
DATABASE_URL=""
DIRECT_DATABASE_URL=""
# After Prisma schema changes (new columns, enum values), sync the DB from app/: pnpm run prisma-db-push (or make prisma-push).

# Optional — Supabase HTTP (Auth, Storage, PostgREST). Not read by Prisma.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket id from Supabase Dashboard → Storage (create bucket; set public for read if using getPublicUrl).
SUPABASE_STORAGE_BUCKET=""
# Brand Asset Library in Design Media (Polotno) — separate from user uploads; default bucket name: assets
SUPABASE_BRAND_ASSETS_BUCKET="assets"

REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"

# === This needs to be exactly the URL you're accessing Postiz on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# Nest reads NEXT_PUBLIC_BACKEND_URL at runtime for Content Cop webhook_url (use HTTPS in prod).

# Content Cop (Compliance Hub) — social compliance jobs
CONTENT_COP_API_KEY=""
CONTENT_COP_BASE_URL=""   # URL of your compliance hub API
# Optional: only if the webhook base must differ from NEXT_PUBLIC_BACKEND_URL (e.g. ngrok HTTPS while the API URL stays http://localhost).
# CONTENT_COP_WEBHOOK_PUBLIC_URL="https://your-subdomain.ngrok-free.app"
# Set to "true" to enable the full compliance pipeline (settings tab, calendar badges, ManageModal report, Slack alerts).
# When unset or "false", all /api/compliance/* routes return 404 and the UI surface is hidden.
COMPLIANCE_ENABLED=true

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## This is a dummy key, you must create your own from Resend.
## If this variable exists, user activation is required.
## If it is commented out, users are activated automatically.
#RESEND_API_KEY="RzeTwHijvxvPUerScFcenUZUALuQJzSaGSMJ"
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
#DISABLE_REGISTRATION=false

# Where will social media icons be saved - local or cloudflare.
STORAGE_PROVIDER="local"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#UPLOAD_DIRECTORY=""

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
# Public URL segment for browser + posts (must match how files are served, e.g. /uploads/...).
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="uploads"

# Social Media API Settings
X_URL=""
# X OAuth2 (see x.provider.ts) — not X_API_KEY / X_API_SECRET.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_PAGE_CLIENT_ID="" # Separate LinkedIn app for Community Management API scopes
LINKEDIN_PAGE_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""   # Optional server-wide fallback — orgs can BYOK in Settings → API Keys (AI image/content generation)
# OPENAI_IMAGE_MODEL="gpt-image-1"   # optional override (default: gpt-image-1)
REPLICATE_API_TOKEN=""   # Optional server-wide fallback — orgs can BYOK in Settings → API Keys (AI erase)
# GOOGLE_API_KEY=""   # Optional alias for Gemini image edit; GEMINI_API_KEY is preferred
NEXT_PUBLIC_DISCORD_SUPPORT=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# Payment settings
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTIZ_GENERIC_OAUTH="false"
POSTIZ_OAUTH_URL="https://auth.example.com"
POSTIZ_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTIZ_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTIZ_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTIZ_OAUTH_CLIENT_ID=""
POSTIZ_OAUTH_CLIENT_SECRET=""
# POSTIZ_OAUTH_SCOPE="openid profile email" # default values

# === AI / Image Services
GEMINI_API_KEY=""   # Optional server-wide fallback — orgs can BYOK in Settings → API Keys (captions + AI image edit)
GENER8_API_KEY=""   # Required for image generation via Gener8
GENER8_BASE_URL=""  # Base URL for the Gener8 API (e.g. https://api.yourdomain.com)
# Comma-separated hostname suffixes for vendor image URLs that may resolve to private IPs in VPC DNS (split-horizon).
TRUSTED_DOWNLOAD_HOST_SUFFIXES=""
AURORA_API_KEY=""   # Video generation API key
AURORA_BASE_URL=""  # Base URL for the Aurora/video cluster API
# Logo substitution in the design pipeline: public URL to your org logo image
ORG_LOGO_URL=""
# Optional: aspect ratio override for your logo (width:height, e.g. 3.2 for a wide wordmark)
# ORG_LOGO_ASPECT=""

# Late API (getlate.dev) — managed social providers (no direct platform app credentials needed)
# BYOK-first: each organization adds its own Late API key in Settings → API Keys.
# LATE_API_KEY below is only an optional server-wide fallback shared by all orgs.
# Managed providers are always shown and replace their direct counterparts:
#   Social:  facebook-late, instagram-late, x-late, linkedin-late, tiktok-late,
#            youtube-late, reddit-late, threads-late, pinterest-late
#   Ads:     meta-ads-late, instagram-ads-late, linkedin-ads-late, tiktok-ads-late,
#            google-ads-late, x-ads-late
#   Comms:   whatsapp-late
# LATE_API_KEY=""

TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""
GOOGLE_CLIENT_ID=""   # YouTube OAuth in this fork (not YOUTUBE_CLIENT_ID)
GOOGLE_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

