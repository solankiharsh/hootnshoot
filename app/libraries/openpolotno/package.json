{
  "name": "openpolotno",
  "version": "1.0.2",
  "description": "Vendored open-source alternative to Polotno — workspace package for in-repo editing.",
  "license": "MIT",
  "type": "module",
  "main": "./src/raeditor-app.tsx",
  "scripts": {
    "build": "tsup"
  },
  "exports": {
    ".": "./src/raeditor-app.tsx",
