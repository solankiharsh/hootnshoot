    "./side-panel/*": "./src/side-panel/*.tsx",
    "./side-panel": "./src/side-panel/index.ts",
    "./canvas/*": "./src/canvas/*.tsx",
    "./model/*": "./src/model/*.ts",
    "./pages-timeline/*": "./src/pages-timeline/*.ts",
    "./pages-timeline": "./src/pages-timeline/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./toolbar/*": "./src/toolbar/*.tsx",
    "./toolbar": "./src/toolbar/toolbar.tsx"
  },
  "dependencies": {
    "@blueprintjs/core": "5.19.0",
    "@blueprintjs/icons": "^5.23.0",
    "@blueprintjs/select": "5.3.20",
    "@meronex/icons": "^4.0.0",
    "cssom": "^0.5.0",
    "dompurify": "^3.3.3",
    "fast-json-patch": "^3.1.1",
    "functions-have-names": "^1.2.3",
    "gifuct-js": "^2.1.2",
    "gradient-parser": "^1.1.1",
    "konva": "^10.0.4",
    "mensch": "^0.3.4",
    "mobx": "6.13.7",
    "mobx-react-lite": "^4.1.0",
    "mobx-state-tree": "6.0.1",
    "nanoid": "3.3.4",
    "lodash": "^4.18.0",
    "quill": "^1.3.7",
    "rasterizehtml": "^1.3.1",
    "react-color": "^2.19.3",
    "reactcss": "^1.2.3",
    "react-konva": "^19.2.3",
    "react-konva-utils": "^2.0.0",
    "react-sortablejs": "6.1.4",
    "react-window": "^1.8.11",
    "sortablejs": "^1.15.6",
    "svg-round-corners": "^0.4.3",
    "swr": "^2.3.4",
    "use-image": "^1.1.4"
