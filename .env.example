# Hootnshoot — root environment template
# Copy to .env, fill in your values, then run `make env` (host dev) or
# `docker compose up` (full stack). See app/.env.example for the full
# reference of every supported variable.
#
# BYOK-first: Late / OpenAI / Gemini / Replicate API keys are entered by each
# organization in Settings → API Keys inside the app. The variables below act
# only as optional server-wide fallbacks.

# --- Required ---
JWT_SECRET=                       # long random string, e.g. `openssl rand -hex 64`

# Postgres. For docker-compose dev infra these are overridden by `make env`.
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Infrastructure (defaults fine for docker compose) ---
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_POSTGRES_PASSWORD=       # random string for the bundled Temporal Postgres

# --- URLs (set to your public hostname when deploying, e.g. Cloudflare Tunnel) ---
MAIN_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000

# --- Storage: local | cloudflare (R2) | supabase ---
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=./.local/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# Cloudflare R2 (when STORAGE_PROVIDER=cloudflare)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=
# CLOUDFLARE_REGION=auto

# --- Cloudflare Tunnel (docker compose --profile tunnel) ---
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional server-wide API key fallbacks (orgs can BYOK in Settings → API Keys) ---
# LATE_API_KEY=
# LATE_API_URL=https://getlate.dev/api/v1
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# REPLICATE_API_TOKEN=

# --- Misc ---
IS_GENERAL=true
DISABLE_REGISTRATION=false
